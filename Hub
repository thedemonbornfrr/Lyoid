            player:Kick("Too many invalid key attempts. You are banned from using this script.")
            return
        end
        
        if keyInput.Text:lower() == REQUIRED_KEY:lower() then
            keyAttempts = 0
            saveKey()
            playSuccessSound()
            screenGui:Destroy()
            blurEffect:Destroy()
            createMainHub()
            
            showNotification("Script loaded successfully! Ready to farm brainrots!")
